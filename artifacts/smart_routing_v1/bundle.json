    "schema": {
      "inputs": {
        "amount": {
          "type": "float",
          "required": true,
          "default": null,
          "min": 0.01,
          "max": 1000000.0,
          "enum": null,
          "regex": null,
          "description": "Transaction amount in primary currency units (e.g., 49.99)"
        },
        "currency": {
          "type": "string",
          "required": true,
          "default": null,
          "min": null,
          "max": null,
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "CAD",
            "AUD",
            "JPY",
            "CHF",
            "SEK",
            "NOK",
            "SGD"
          ],
          "regex": null,
          "description": "ISO 4217 three-letter currency code"
        },
        "card_brand": {
          "type": "string",
          "required": true,
          "default": null,
          "min": null,
          "max": null,
          "enum": [
            "visa",
            "mastercard",
            "amex",
            "discover",
            "jcb",
            "unionpay",
            "diners"
          ],
          "regex": null,
          "description": "Payment card network brand"
        },
        "bin_country": {
          "type": "string",
          "required": true,
          "default": null,
          "min": null,
          "max": null,
          "enum": null,
          "regex": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 card issuing country code (e.g., US, GB, DE)"
        },
        "mcc": {
          "type": "string",
          "required": true,
          "default": null,
          "min": null,
          "max": null,
          "enum": null,
          "regex": "^[0-9]{4}$",
          "description": "4-digit ISO 18245 Merchant Category Code (e.g., 5411, 5732, 7995)"
        },
        "velocity_1h": {
          "type": "integer",
          "required": true,
          "default": null,
          "min": 0.0,
          "max": 500.0,
          "enum": null,
          "regex": null,
          "description": "Number of transaction attempts associated with card/fingerprint in last 60 minutes"
        }
      }
    },
    "choices": {
