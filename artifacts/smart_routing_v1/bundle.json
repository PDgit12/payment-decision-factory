      "score": {
        "scaling_method": "temperature_scaling",
        "temperature": 0.85,
        "brier_score_target": 0.08,
        "confidence_floor": 0.4,
        "uncertainty_threshold": 0.38,
        "utility_factors": {
          "acceptance_weight": 0.5,
          "cost_efficiency_weight": 0.3,
          "latency_weight": 0.2
        }
      },
      "noul": {
        "circuit_breaker_active": true,
        "fallback_action": "STEP_DOWN_CHALLENGE",
        "max_velocity_threshold": 15,
        "high_value_velocity_threshold": 6,
        "high_value_amount_threshold": 25000.0,
        "suspicious_mccs": [
          "7995",
          "6051",
          "6211"
        ],
        "min_confidence_floor": 0.35,
        "rules": [
          {
            "name": "excessive_velocity_circuit_breaker",
            "condition": "velocity_1h >= 15",
            "action": "STEP_DOWN_CHALLENGE",
            "reason": "Card attempt velocity exceeds safe threshold (>15/hr); risk of card testing or automated attack."
          },
          {
            "name": "high_value_velocity_burst",
            "condition": "amount >= 25000.0 and velocity_1h >= 6",
            "action": "MANUAL_REVIEW",
            "reason": "High ticket transaction combined with elevated hourly velocity."
          },
          {
            "name": "uncertainty_boundary",
            "condition": "confidence < 0.35",
            "action": "ROUTE_TO_DEFAULT_WITH_FLAG",
            "reason": "Decision entropy too high; routed to resilient global fallback rail."
          }
        ]
      }
    },
